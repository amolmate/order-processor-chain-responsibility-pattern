{
  "family": "wholesale-amazon-orders-reconciliation-pre",
  "taskRoleArn": "arn:aws:iam::020551178989:role/xxwmm_wholesale_orders_ecstask_role",
  "containerDefinitions": [
    {
      "name": "wholesale-amazon-orders-reconciliation-pre",
      "image": "020551178989.dkr.ecr.eu-west-1.amazonaws.com/wholesale/wholesale-amazon-orders-reconciliation:pre",
      "cpu": 200,
      "memory": 2048,
      "memoryReservation":1024,
      "entryPoint": [
        "/bin/bash"
      ],
      "command": [
        "/app/wh/orderreconciliation/bin/runApp",
        "pre"
      ],
      "portMappings": [
        {
          "containerPort": 8080
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "xxwmm_env",
          "value": "pre"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "wholesale-amazon-orders-reconciliation-pre",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "wholesale-amazon-orders-reconciliation"
        }
      }
    }
  ]
}