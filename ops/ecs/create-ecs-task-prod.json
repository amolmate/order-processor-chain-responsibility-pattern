{
  "family": "wholesale-amazon-orders-reconciliation-prod",
  "taskRoleArn": "arn:aws:iam::337473618329:role/xxwmm_wholesale_orders_ecstask_role",
  "containerDefinitions": [
    {
      "name": "wholesale-amazon-orders-reconciliation-prod",
      "image": "337473618329.dkr.ecr.eu-west-1.amazonaws.com/wholesale/wholesale-amazon-orders-reconciliation:prod"
      ,
      "cpu": 400,
      "memory": 2048,
      "memoryReservation":1024,
      "entryPoint": [
        "/bin/bash"
      ],
      "command": [
        "/app/wh/orderprocessor/bin/runApp",
        "prod"
      ],
      "portMappings": [
        {
          "containerPort": 8080
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "xxwmm_env",
          "value": "prod"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "wholesale-amazon-orders-reconciliation-prd",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "wholesale-amazon-orders-reconciliation"
        }
      }
    }
  ]
}