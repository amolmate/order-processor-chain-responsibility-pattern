{
  "family": "wholesale-dsd-order-processor-dev",
  "taskRoleArn": "arn:aws:iam::020551178989:role/xxwmm_wholesale_orders_ecstask_role",
  "containerDefinitions": [
    {
      "name": "wholesale-dsd-order-processor-dev",
      "image": "020551178989.dkr.ecr.eu-west-1.amazonaws.com/wholesale-dsd-order-processor:dev",
      "cpu": 50,
      "memory": 1024,
      "entryPoint": [
        "/bin/bash"
      ],
      "command": [
        "/app/wh/orderprocessor/bin/runApp",
        "dev"
      ],
      "portMappings": [
        {
          "containerPort": 8080
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "xxwmm_env",
          "value": "dev"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "wholesale-dsd-order-processor-dev",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "wholesale-dsd-order-processor"
        }
      }
    }
  ]
}
